# Copy to .env.local and fill in values from `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase start>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase start>

# Semaphore SMS (https://semaphore.co). DRY_RUN defaults to true so routine
# test runs never spend credits; flip deliberately for a one-time real send.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SEMAPHORE_DRY_RUN=true

# Bearer secret protecting /api/cron/send-reminders (any random string).
CRON_SECRET=
